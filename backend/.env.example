# Server Port
PORT=5000

# Google Gemini API Key (keep secret, never expose in frontend)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Gemini model override
GEMINI_MODEL=gemini-3.8-flash

# Allowed frontend origin for CORS
FRONTEND_ORIGIN=http://localhost:5173

# Optional path for the private farmer-account SQLite database
# Defaults to backend/data/krishi-mitra.sqlite
# AUTH_DB_PATH=C:\path\to\private\krishi-mitra.sqlite
